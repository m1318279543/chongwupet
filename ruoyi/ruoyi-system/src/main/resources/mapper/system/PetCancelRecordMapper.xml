<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetCancelRecordMapper">

    <resultMap type="PetCancelRecord" id="PetCancelRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="targetType"  column="target_type"  />
        <result property="refId"       column="ref_id"       />
        <result property="userId"      column="user_id"      />
        <result property="userName"    column="user_name"    />
        <result property="targetName"  column="target_name"  />
        <result property="detail"      column="detail"       />
        <result property="reason"      column="reason"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectPetCancelRecordVo">
        select r.record_id, r.target_type, r.ref_id, r.user_id, r.user_name, r.target_name,
               r.detail, r.reason, r.del_flag, r.create_by, r.create_time, r.remark
        from pet_cancel_record r
    </sql>

    <select id="selectPetCancelRecordList" parameterType="PetCancelRecord" resultMap="PetCancelRecordResult">
        <include refid="selectPetCancelRecordVo"/>
        <where>
            r.del_flag = '0'
            <if test="targetType != null and targetType != ''">
                AND r.target_type = #{targetType}
            </if>
            <if test="userId != null">
                AND r.user_id = #{userId}
            </if>
            <if test="userName != null and userName != ''">
                AND r.user_name like concat('%', #{userName}, '%')
            </if>
            <if test="targetName != null and targetName != ''">
                AND r.target_name like concat('%', #{targetName}, '%')
            </if>
            <if test="reason != null and reason != ''">
                AND r.reason like concat('%', #{reason}, '%')
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND r.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND r.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by r.record_id desc
    </select>

    <select id="selectPetCancelRecordByRecordId" parameterType="Long" resultMap="PetCancelRecordResult">
        <include refid="selectPetCancelRecordVo"/>
        where r.record_id = #{recordId}
    </select>

    <insert id="insertPetCancelRecord" parameterType="PetCancelRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into pet_cancel_record(
            <if test="targetType != null and targetType != ''">target_type,</if>
            <if test="refId != null">ref_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="targetName != null and targetName != ''">target_name,</if>
            <if test="detail != null and detail != ''">detail,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="targetType != null and targetType != ''">#{targetType},</if>
            <if test="refId != null">#{refId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="targetName != null and targetName != ''">#{targetName},</if>
            <if test="detail != null and detail != ''">#{detail},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <delete id="deletePetCancelRecordByRecordIds" parameterType="Long">
        delete from pet_cancel_record where record_id in
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <delete id="deletePetCancelRecordAll">
        delete from pet_cancel_record
    </delete>

</mapper>
