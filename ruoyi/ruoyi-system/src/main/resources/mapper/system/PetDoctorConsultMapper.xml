<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetDoctorConsultMapper">

    <resultMap type="PetDoctorConsult" id="PetDoctorConsultResult">
        <result property="consultId"   column="consult_id"   />
        <result property="userId"      column="user_id"      />
        <result property="userName"    column="user_name"    />
        <result property="question"    column="question"     />
        <result property="answer"      column="answer"       />
        <result property="source"      column="source"       />
        <result property="model"       column="model"        />
        <result property="matchCount"  column="match_count"  />
        <result property="ip"          column="ip"           />
        <result property="delFlag"     column="del_flag"     />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <sql id="selectPetDoctorConsultVo">
        select c.consult_id, c.user_id, c.user_name, c.question, c.answer, c.source,
               c.model, c.match_count, c.ip, c.del_flag, c.create_time
        from pet_doctor_consult c
    </sql>

    <select id="selectPetDoctorConsultList" parameterType="PetDoctorConsult" resultMap="PetDoctorConsultResult">
        <include refid="selectPetDoctorConsultVo"/>
        <where>
            c.del_flag = '0'
            <if test="userId != null">
                AND c.user_id = #{userId}
            </if>
            <if test="userName != null and userName != ''">
                AND c.user_name like concat('%', #{userName}, '%')
            </if>
            <if test="question != null and question != ''">
                AND c.question like concat('%', #{question}, '%')
            </if>
            <if test="source != null and source != ''">
                AND c.source = #{source}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND c.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND c.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by c.consult_id desc
    </select>

    <select id="selectPetDoctorConsultByConsultId" parameterType="Long" resultMap="PetDoctorConsultResult">
        <include refid="selectPetDoctorConsultVo"/>
        where c.consult_id = #{consultId}
    </select>

    <insert id="insertPetDoctorConsult" parameterType="PetDoctorConsult" useGeneratedKeys="true" keyProperty="consultId">
        insert into pet_doctor_consult(
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="question != null and question != ''">question,</if>
            <if test="answer != null and answer != ''">answer,</if>
            <if test="source != null and source != ''">source,</if>
            <if test="model != null and model != ''">model,</if>
            <if test="matchCount != null">match_count,</if>
            <if test="ip != null and ip != ''">ip,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
            create_time
        )values(
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="question != null and question != ''">#{question},</if>
            <if test="answer != null and answer != ''">#{answer},</if>
            <if test="source != null and source != ''">#{source},</if>
            <if test="model != null and model != ''">#{model},</if>
            <if test="matchCount != null">#{matchCount},</if>
            <if test="ip != null and ip != ''">#{ip},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
            sysdate()
        )
    </insert>

    <delete id="deletePetDoctorConsultByConsultIds" parameterType="Long">
        delete from pet_doctor_consult where consult_id in
        <foreach item="consultId" collection="array" open="(" separator="," close=")">
            #{consultId}
        </foreach>
    </delete>

    <delete id="deletePetDoctorConsultAll">
        delete from pet_doctor_consult
    </delete>

</mapper>
