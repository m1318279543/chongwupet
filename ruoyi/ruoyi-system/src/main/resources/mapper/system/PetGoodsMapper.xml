<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetGoodsMapper">

    <resultMap type="PetGoods" id="PetGoodsResult">
        <result property="goodsId"     column="goods_id"     />
        <result property="goodsCode"   column="goods_code"   />
        <result property="goodsName"   column="goods_name"   />
        <result property="cat"         column="cat"          />
        <result property="goodsType"   column="goods_type"   />
        <result property="spec"        column="spec"         />
        <result property="price"       column="price"        />
        <result property="originPrice" column="origin_price" />
        <result property="stock"       column="stock"        />
        <result property="unit"        column="unit"         />
        <result property="image"       column="image"        />
        <result property="stage"       column="stage"        />
        <result property="description" column="description"  />
        <result property="tags"        column="tags"         />
        <result property="nutrition"   column="nutrition"    />
        <result property="feeding"     column="feeding"      />
        <result property="storage"     column="storage"      />
        <result property="status"      column="status"       />
        <result property="sort"        column="sort"         />
        <result property="delFlag"     column="del_flag"     />
        <result property="remark"      column="remark"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <resultMap type="PetGoodsSku" id="PetGoodsSkuResult">
        <result property="skuId"     column="sku_id"     />
        <result property="goodsId"   column="goods_id"   />
        <result property="skuName"   column="sku_name"   />
        <result property="spec"      column="spec"       />
        <result property="price"     column="price"      />
        <result property="stock"     column="stock"      />
        <result property="status"    column="status"     />
        <result property="delFlag"   column="del_flag"   />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <resultMap type="PetStockLog" id="PetStockLogResult">
        <result property="logId"      column="log_id"      />
        <result property="goodsId"    column="goods_id"    />
        <result property="skuId"      column="sku_id"      />
        <result property="goodsName"  column="goods_name"  />
        <result property="skuName"    column="sku_name"    />
        <result property="changeType" column="change_type" />
        <result property="qty"        column="qty"         />
        <result property="beforeQty"  column="before_qty"  />
        <result property="afterQty"   column="after_qty"   />
        <result property="bizNo"      column="biz_no"      />
        <result property="operator"   column="operator"    />
        <result property="remark"     column="remark"      />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectPetGoodsVo">
        select goods_id, goods_code, goods_name, cat, goods_type, spec, price, origin_price, stock, unit,
               image, stage, description, tags, nutrition, feeding, storage, status, sort, del_flag,
               remark, create_by, create_time, update_by, update_time
        from pet_goods
    </sql>

    <select id="selectPetGoodsList" parameterType="PetGoods" resultMap="PetGoodsResult">
        <include refid="selectPetGoodsVo"/>
        <where>
            del_flag = '0'
            <if test="keyword != null and keyword != ''">
                AND (goods_name like concat('%', #{keyword}, '%') or goods_code like concat('%', #{keyword}, '%'))
            </if>
            <if test="goodsName != null and goodsName != ''">
                AND goods_name like concat('%', #{goodsName}, '%')
            </if>
            <if test="cat != null and cat != ''">
                AND cat = #{cat}
            </if>
            <if test="goodsType != null and goodsType != ''">
                AND goods_type = #{goodsType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="lowStock != null">
                AND stock &lt;= #{lowStock}
            </if>
        </where>
        order by sort asc, goods_id asc
    </select>

    <select id="selectPetGoodsById" parameterType="Long" resultMap="PetGoodsResult">
        <include refid="selectPetGoodsVo"/>
        where goods_id = #{goodsId}
    </select>

    <select id="selectPetGoodsByCode" resultMap="PetGoodsResult">
        <include refid="selectPetGoodsVo"/>
        where goods_code = #{goodsCode} and del_flag = '0' limit 1
    </select>

    <select id="selectSkusByGoodsId" parameterType="Long" resultMap="PetGoodsSkuResult">
        select sku_id, goods_id, sku_name, spec, price, stock, status, del_flag, create_time, update_time
        from pet_goods_sku
        where goods_id = #{goodsId} and del_flag = '0'
        order by sku_id asc
    </select>

    <select id="selectSkuById" parameterType="Long" resultMap="PetGoodsSkuResult">
        select sku_id, goods_id, sku_name, spec, price, stock, status, del_flag, create_time, update_time
        from pet_goods_sku
        where sku_id = #{skuId}
    </select>

    <insert id="insertPetGoods" parameterType="PetGoods" useGeneratedKeys="true" keyProperty="goodsId">
        insert into pet_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsCode != null and goodsCode != ''">goods_code,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="cat != null">cat,</if>
            <if test="goodsType != null">goods_type,</if>
            <if test="spec != null">spec,</if>
            <if test="price != null">price,</if>
            <if test="originPrice != null">origin_price,</if>
            <if test="stock != null">stock,</if>
            <if test="unit != null">unit,</if>
            <if test="image != null">image,</if>
            <if test="stage != null">stage,</if>
            <if test="description != null">description,</if>
            <if test="tags != null">tags,</if>
            <if test="nutrition != null">nutrition,</if>
            <if test="feeding != null">feeding,</if>
            <if test="storage != null">storage,</if>
            <if test="status != null">status,</if>
            <if test="sort != null">sort,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsCode != null and goodsCode != ''">#{goodsCode},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="cat != null">#{cat},</if>
            <if test="goodsType != null">#{goodsType},</if>
            <if test="spec != null">#{spec},</if>
            <if test="price != null">#{price},</if>
            <if test="originPrice != null">#{originPrice},</if>
            <if test="stock != null">#{stock},</if>
            <if test="unit != null">#{unit},</if>
            <if test="image != null">#{image},</if>
            <if test="stage != null">#{stage},</if>
            <if test="description != null">#{description},</if>
            <if test="tags != null">#{tags},</if>
            <if test="nutrition != null">#{nutrition},</if>
            <if test="feeding != null">#{feeding},</if>
            <if test="storage != null">#{storage},</if>
            <if test="status != null">#{status},</if>
            <if test="sort != null">#{sort},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updatePetGoods" parameterType="PetGoods">
        update pet_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="cat != null">cat = #{cat},</if>
            <if test="goodsType != null">goods_type = #{goodsType},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="price != null">price = #{price},</if>
            <if test="originPrice != null">origin_price = #{originPrice},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="unit != null">unit = #{unit},</if>
            <if test="image != null">image = #{image},</if>
            <if test="stage != null">stage = #{stage},</if>
            <if test="description != null">description = #{description},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="nutrition != null">nutrition = #{nutrition},</if>
            <if test="feeding != null">feeding = #{feeding},</if>
            <if test="storage != null">storage = #{storage},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where goods_id = #{goodsId}
    </update>

    <update id="deletePetGoodsByIds" parameterType="Long">
        update pet_goods set del_flag = '2', status = '1' where goods_id in
        <foreach item="goodsId" collection="array" open="(" separator="," close=")">
            #{goodsId}
        </foreach>
    </update>

    <insert id="insertPetSku" parameterType="PetGoodsSku" useGeneratedKeys="true" keyProperty="skuId">
        insert into pet_goods_sku (goods_id, sku_name, spec, price, stock, status, create_time)
        values (#{goodsId}, #{skuName}, #{spec}, #{price}, #{stock}, '0', sysdate())
    </insert>

    <update id="updatePetSku" parameterType="PetGoodsSku">
        update pet_goods_sku
        <trim prefix="SET" suffixOverrides=",">
            <if test="skuName != null">sku_name = #{skuName},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="price != null">price = #{price},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="status != null">status = #{status},</if>
            update_time = sysdate()
        </trim>
        where sku_id = #{skuId}
    </update>

    <update id="deductStock">
        update pet_goods_sku set stock = stock - #{qty}, update_time = sysdate()
        where sku_id = #{skuId} and stock &gt;= #{qty}
    </update>

    <update id="addStock">
        update pet_goods_sku set stock = stock + #{qty}, update_time = sysdate()
        where sku_id = #{skuId}
    </update>

    <update id="refreshGoodsStock" parameterType="Long">
        update pet_goods
        set stock = (select ifnull(sum(s.stock), 0) from pet_goods_sku s where s.goods_id = #{goodsId} and s.del_flag = '0')
        where goods_id = #{goodsId}
    </update>

    <insert id="insertStockLog" parameterType="PetStockLog" useGeneratedKeys="true" keyProperty="logId">
        insert into pet_stock_log (goods_id, sku_id, goods_name, sku_name, change_type, qty, before_qty, after_qty, biz_no, operator, remark, create_time)
        values (#{goodsId}, #{skuId}, #{goodsName}, #{skuName}, #{changeType}, #{qty}, #{beforeQty}, #{afterQty}, #{bizNo}, #{operator}, #{remark}, sysdate())
    </insert>

    <select id="selectStockLogList" parameterType="PetStockLog" resultMap="PetStockLogResult">
        select log_id, goods_id, sku_id, goods_name, sku_name, change_type, qty, before_qty, after_qty,
               biz_no, operator, remark, create_time
        from pet_stock_log
        <where>
            <if test="goodsId != null">AND goods_id = #{goodsId}</if>
            <if test="skuId != null">AND sku_id = #{skuId}</if>
            <if test="changeType != null and changeType != ''">AND change_type = #{changeType}</if>
            <if test="goodsName != null and goodsName != ''">
                AND (goods_name like concat('%', #{goodsName}, '%') or biz_no like concat('%', #{goodsName}, '%'))
            </if>
        </where>
        order by log_id desc
    </select>

    <select id="selectLowStockGoods" resultMap="PetGoodsResult">
        <include refid="selectPetGoodsVo"/>
        where del_flag = '0' and status = '0' and stock &lt;= #{threshold}
        order by stock asc
    </select>

</mapper>
