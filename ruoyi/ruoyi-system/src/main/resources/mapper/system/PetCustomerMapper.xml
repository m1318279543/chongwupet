<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetCustomerMapper">

    <resultMap type="PetCustomer" id="PetCustomerResult">
        <result property="customerId"    column="customer_id"     />
        <result property="customerCode"  column="customer_code"   />
        <result property="userId"        column="user_id"         />
        <result property="customerName"  column="customer_name"   />
        <result property="phone"         column="phone"           />
        <result property="gender"        column="gender"          />
        <result property="birthday"      column="birthday"        />
        <result property="storeId"       column="store_id"        />
        <result property="storeName"     column="store_name"      />
        <result property="level"         column="level"           />
        <result property="source"        column="source"          />
        <result property="tags"          column="tags"            />
        <result property="orderCount"    column="order_count"     />
        <result property="totalAmount"   column="total_amount"    />
        <result property="firstDealTime" column="first_deal_time" />
        <result property="lastDealTime"  column="last_deal_time"  />
        <result property="status"        column="status"          />
        <result property="petCount"      column="pet_count"       />
        <result property="createBy"      column="create_by"       />
        <result property="createTime"    column="create_time"     />
        <result property="updateBy"      column="update_by"       />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"        column="remark"          />
    </resultMap>

    <sql id="selectPetCustomerVo">
        select c.customer_id, c.customer_code, c.user_id, c.customer_name, c.phone, c.gender, c.birthday,
               c.store_id, s.store_name, c.level, c.source, c.tags, c.order_count, c.total_amount,
               c.first_deal_time, c.last_deal_time, c.status, c.create_by, c.create_time,
               c.update_by, c.update_time, c.remark,
               (select count(*) from pet_owner o where o.customer_id = c.customer_id and o.end_time is null) as pet_count
        from pet_customer c
        left join pet_store s on s.store_id = c.store_id
    </sql>

    <select id="selectPetCustomerList" parameterType="PetCustomer" resultMap="PetCustomerResult">
        <include refid="selectPetCustomerVo"/>
        <where>
            c.del_flag = '0'
            <if test="customerName != null and customerName != ''">
                AND c.customer_name like concat('%', #{customerName}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND c.phone like concat('%', #{phone}, '%')
            </if>
            <if test="customerCode != null and customerCode != ''">
                AND c.customer_code like concat('%', #{customerCode}, '%')
            </if>
            <if test="level != null and level != ''">
                AND c.level = #{level}
            </if>
            <if test="source != null and source != ''">
                AND c.source = #{source}
            </if>
            <if test="status != null and status != ''">
                AND c.status = #{status}
            </if>
            <if test="storeId != null">
                AND c.store_id = #{storeId}
            </if>
            <if test="tags != null and tags != ''">
                AND c.tags like concat('%', #{tags}, '%')
            </if>
        </where>
        order by c.last_deal_time is null, c.last_deal_time desc, c.customer_id desc
    </select>

    <select id="selectPetCustomerByCustomerId" parameterType="Long" resultMap="PetCustomerResult">
        <include refid="selectPetCustomerVo"/>
        where c.customer_id = #{customerId} and c.del_flag = '0'
    </select>

    <resultMap type="PetOwner" id="PetOwnerResult">
        <result property="ownerId"      column="owner_id"      />
        <result property="petId"        column="pet_id"        />
        <result property="customerId"   column="customer_id"   />
        <result property="relation"     column="relation"      />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"      column="end_time"      />
        <result property="petName"      column="pet_name"      />
        <result property="image"        column="image"         />
        <result property="breed"        column="breed"         />
        <result property="age"          column="age"           />
        <result property="categoryName" column="category_name" />
        <result property="price"        column="price"         />
    </resultMap>

    <select id="selectPetsByCustomerId" parameterType="Long" resultMap="PetOwnerResult">
        select o.owner_id, o.pet_id, o.customer_id, o.relation, o.start_time, o.end_time,
               p.pet_name, p.image, p.breed, p.age, p.price, pc.category_name
        from pet_owner o
        join pet_info p on p.pet_id = o.pet_id
        left join pet_category pc on pc.category_id = p.category_id
        where o.customer_id = #{customerId} and o.del_flag = '0'
        order by o.end_time is null desc, o.start_time desc
    </select>

    <select id="selectPetCustomerByUserId" resultMap="PetCustomerResult">
        <include refid="selectPetCustomerVo"/>
        where c.user_id = #{userId} and c.del_flag = '0'
        limit 1
    </select>

    <select id="selectCustomerIdByUserId" resultType="Long">
        select customer_id from pet_customer
        where user_id = #{userId} and del_flag = '0'
        limit 1
    </select>

    <insert id="insertPetCustomer" parameterType="PetCustomer" useGeneratedKeys="true" keyProperty="customerId">
        insert into pet_customer(
            customer_code, user_id, customer_name, phone, gender, birthday, store_id, level, source, tags,
            order_count, total_amount, status, del_flag,
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            #{customerCode}, #{userId}, #{customerName}, #{phone}, #{gender}, #{birthday}, #{storeId}, #{level}, #{source}, #{tags},
            ifnull(#{orderCount}, 0), ifnull(#{totalAmount}, 0), #{status}, '0',
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updatePetCustomer" parameterType="PetCustomer">
        update pet_customer
        <set>
            <if test="customerName != null and customerName != ''">customer_name = #{customerName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="storeId != null">store_id = #{storeId},</if>
            <if test="level != null and level != ''">level = #{level},</if>
            <if test="source != null and source != ''">source = #{source},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where customer_id = #{customerId}
    </update>

    <delete id="deletePetCustomerByCustomerIds" parameterType="Long">
        delete from pet_customer where customer_id in
        <foreach item="customerId" collection="array" open="(" separator="," close=")">
            #{customerId}
        </foreach>
    </delete>

    <select id="countPetsByCustomerId" parameterType="Long" resultType="int">
        select count(*) from pet_owner where customer_id = #{customerId} and end_time is null
    </select>

</mapper>
