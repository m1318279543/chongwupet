<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetCartMapper">

    <resultMap type="PetCart" id="PetCartResult">
        <result property="cartId"     column="cart_id"     />
        <result property="userId"     column="user_id"     />
        <result property="userName"   column="user_name"   />
        <result property="goodsName"  column="goods_name"  />
        <result property="goodsImage" column="goods_image" />
        <result property="goodsSpec"  column="goods_spec"  />
        <result property="price"      column="price"       />
        <result property="qty"        column="qty"         />
        <result property="amount"     column="amount"      />
        <result property="status"     column="status"      />
        <result property="orderNo"    column="order_no"    />
        <result property="payStatus"  column="pay_status"  />
        <result property="payMethod"  column="pay_method"  />
        <result property="payTime"    column="pay_time"    />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="remark"     column="remark"      />
        <result property="lastPayResult" column="last_pay_result" />
        <result property="lastPayReason" column="last_pay_reason" />
        <result property="payAttempts"   column="pay_attempts"    />
    </resultMap>

    <sql id="selectPetCartVo">
        select c.cart_id, c.user_id, c.user_name, c.goods_name, c.goods_image, c.goods_spec,
               c.price, c.qty, c.amount, c.status, c.order_no, c.pay_status, c.pay_method, c.pay_time,
               c.create_by, c.create_time, c.remark,
               (select l.result from pet_payment_log l where l.order_no = c.order_no order by l.log_id desc limit 1) as last_pay_result,
               (select l.reason from pet_payment_log l where l.order_no = c.order_no order by l.log_id desc limit 1) as last_pay_reason,
               (select count(1) from pet_payment_log l where l.order_no = c.order_no) as pay_attempts
        from pet_cart c
    </sql>

    <select id="selectPetCartList" parameterType="PetCart" resultMap="PetCartResult">
        <include refid="selectPetCartVo"/>
        <where>
            <if test="userId != null">
                AND c.user_id = #{userId}
            </if>
            <if test="userName != null and userName != ''">
                AND c.user_name like concat('%', #{userName}, '%')
            </if>
            <if test="goodsName != null and goodsName != ''">
                AND c.goods_name like concat('%', #{goodsName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND c.status = #{status}
            </if>
            <if test="orderNo != null and orderNo != ''">
                AND c.order_no = #{orderNo}
            </if>
            <if test="payStatus != null and payStatus != ''">
                AND c.pay_status = #{payStatus}
            </if>
            <if test="payMethod != null and payMethod != ''">
                AND c.pay_method = #{payMethod}
            </if>
            <!-- 支付状态分组筛选：已支付 / 待支付 / 支付失败 / 已取消 -->
            <if test="payState != null and payState != ''">
                <choose>
                    <when test="payState == 'paid'">
                        AND c.status &lt;&gt; '3' AND c.pay_status = '1'
                    </when>
                    <when test="payState == 'unpaid'">
                        AND c.status &lt;&gt; '3' AND (c.pay_status IS NULL OR c.pay_status = '0')
                    </when>
                    <when test="payState == 'fail'">
                        AND c.status &lt;&gt; '3' AND (c.pay_status IS NULL OR c.pay_status = '0')
                        AND EXISTS (SELECT 1 FROM pet_payment_log l WHERE l.order_no = c.order_no AND l.result = 'fail')
                    </when>
                    <when test="payState == 'canceled'">
                        AND c.status = '3'
                    </when>
                </choose>
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND c.create_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND c.create_time &lt;= #{params.endTime}
            </if>
        </where>
        order by c.cart_id desc
    </select>

    <select id="selectPetCartByCartId" parameterType="Long" resultMap="PetCartResult">
        <include refid="selectPetCartVo"/>
        where c.cart_id = #{cartId}
    </select>

    <insert id="insertPetCart" parameterType="PetCart" useGeneratedKeys="true" keyProperty="cartId">
        insert into pet_cart(
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="goodsImage != null and goodsImage != ''">goods_image,</if>
            <if test="goodsSpec != null and goodsSpec != ''">goods_spec,</if>
            <if test="price != null">price,</if>
            <if test="qty != null">qty,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="payStatus != null and payStatus != ''">pay_status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="goodsImage != null and goodsImage != ''">#{goodsImage},</if>
            <if test="goodsSpec != null and goodsSpec != ''">#{goodsSpec},</if>
            <if test="price != null">#{price},</if>
            <if test="qty != null">#{qty},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="payStatus != null and payStatus != ''">#{payStatus},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <!-- 修改订单状态（取消订单等） -->
    <update id="updatePetCartStatus">
        update pet_cart
        set status = #{status}, update_time = sysdate()
        where cart_id = #{cartId}
    </update>

    <update id="updatePayStatus">
        update pet_cart
        set pay_status = '1', pay_method = #{payMethod}, pay_time = sysdate(), update_time = sysdate()
        where order_no = #{orderNo} and user_id = #{userId} and pay_status = '0' and status != '3'
    </update>

    <delete id="deletePetCartByCartId" parameterType="Long">
        delete from pet_cart where cart_id = #{cartId}
    </delete>

    <delete id="deletePetCartByCartIds" parameterType="Long">
        delete from pet_cart where cart_id in
        <foreach item="cartId" collection="array" open="(" separator="," close=")">
            #{cartId}
        </foreach>
    </delete>

</mapper>
