<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetCommentMapper">

    <resultMap type="PetComment" id="PetCommentResult">
        <result property="commentId"  column="comment_id"  />
        <result property="petId"      column="pet_id"      />
        <result property="targetType" column="target_type" />
        <result property="userId"     column="user_id"     />
        <result property="parentId"   column="parent_id"   />
        <result property="replyUser"  column="reply_user"  />
        <result property="content"    column="content"     />
        <result property="status"     column="status"      />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
        <result property="userName"   column="user_name"   />
        <result property="avatar"     column="avatar"      />
        <result property="petName"    column="pet_name"    />
        <result property="image"      column="image"       />
    </resultMap>

    <sql id="selectPetCommentVo">
        select c.comment_id, c.pet_id, c.target_type, c.user_id, c.parent_id, c.reply_user, c.content, c.status, c.del_flag,
               c.create_by, c.create_time, c.update_by, c.update_time, c.remark,
               u.user_name as user_name, u.avatar as avatar, p.pet_name as pet_name, p.image as image
        from pet_comment c
        left join sys_user u on u.user_id = c.user_id
        left join pet_info p on p.pet_id = c.pet_id
    </sql>

    <select id="selectPetCommentList" parameterType="PetComment" resultMap="PetCommentResult">
        <include refid="selectPetCommentVo"/>
        <where>
            c.del_flag = '0'
            <if test="userId != null">
                AND c.user_id = #{userId}
            </if>
            <if test="petId != null">
                AND c.pet_id = #{petId}
            </if>
            <if test="targetType != null and targetType != ''">
                AND c.target_type = #{targetType}
            </if>
            <if test="parentId != null">
                AND c.parent_id = #{parentId}
            </if>
            <if test="status != null and status != ''">
                AND c.status = #{status}
            </if>
            <if test="content != null and content != ''">
                AND c.content like concat('%', #{content}, '%')
            </if>
        </where>
        order by c.comment_id desc
    </select>

    <select id="selectPetCommentByCommentId" parameterType="Long" resultMap="PetCommentResult">
        <include refid="selectPetCommentVo"/>
        where c.comment_id = #{commentId}
    </select>

    <select id="countByPetId" parameterType="map" resultType="int">
        select count(*) from pet_comment where pet_id = #{petId} and target_type = #{targetType} and status = '0' and del_flag = '0'
    </select>

    <insert id="insertPetComment" parameterType="PetComment" useGeneratedKeys="true" keyProperty="commentId">
        insert into pet_comment(
            <if test="petId != null">pet_id,</if>
            <if test="targetType != null and targetType != ''">target_type,</if>
            <if test="userId != null">user_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="replyUser != null and replyUser != ''">reply_user,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )        values(
            <if test="petId != null">#{petId},</if>
            <if test="targetType != null and targetType != ''">#{targetType},</if>
            <if test="userId != null">#{userId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="replyUser != null and replyUser != ''">#{replyUser},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updatePetComment" parameterType="PetComment">
        update pet_comment
        <set>
            <if test="replyUser != null">reply_user = #{replyUser},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where comment_id = #{commentId}
    </update>

    <!-- 逻辑删除：前台用户删除自己的评论走这里 -->
    <update id="deletePetCommentByCommentId" parameterType="Long">
        update pet_comment set del_flag = '2' where comment_id = #{commentId}
    </update>

    <update id="deletePetCommentByCommentIds" parameterType="Long">
        update pet_comment set del_flag = '2' where comment_id in
        <foreach item="commentId" collection="array" open="(" separator="," close=")">
            #{commentId}
        </foreach>
    </update>

    <update id="deletePetCommentByPetId" parameterType="Long">
        update pet_comment set del_flag = '2' where pet_id = #{petId}
    </update>

</mapper>
