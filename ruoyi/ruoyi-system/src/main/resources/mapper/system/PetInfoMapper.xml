<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PetInfoMapper">

    <resultMap type="PetInfo" id="PetInfoResult">
        <result property="petId"     column="pet_id"     />
        <result property="categoryId"  column="category_id"   />
        <result property="storeId"  column="store_id"   />
        <result property="petName"  column="pet_name"   />
        <result property="breed"  column="breed"   />
        <result property="age"  column="age"   />
        <result property="gender"  column="gender"   />
        <result property="price"  column="price"   />
        <result property="image"  column="image"   />
        <result property="status"  column="status"   />
        <result property="description"  column="description"   />
        <result property="likeCount"  column="like_count"   />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectPetInfoVo">
        select pet_id, category_id, store_id, pet_name, breed, age, gender, price, image, status, description, like_count, create_by, create_time, update_by, update_time, remark
        from pet_info
    </sql>

    <select id="selectPetInfoList" parameterType="PetInfo" resultMap="PetInfoResult">
        <include refid="selectPetInfoVo"/>
        <where>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="petName != null and petName != ''">
                AND pet_name like concat('%', #{petName}, '%')
            </if>
            <if test="breed != null and breed != ''">
                AND breed like concat('%', #{breed}, '%')
            </if>
            <if test="age != null and age != ''">
                AND age like concat('%', #{age}, '%')
            </if>
            <if test="gender != null and gender != ''">
                AND gender like concat('%', #{gender}, '%')
            </if>
            <if test="price != null">
                AND price = #{price}
            </if>
            <if test="image != null and image != ''">
                AND image like concat('%', #{image}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status like concat('%', #{status}, '%')
            </if>
            <if test="description != null and description != ''">
                AND description like concat('%', #{description}, '%')
            </if>
            <!-- 前台搜索：名称或品种命中 -->
            <if test="params.keyword != null and params.keyword != ''">
                AND (pet_name like concat('%', #{params.keyword}, '%') or breed like concat('%', #{params.keyword}, '%'))
            </if>
            <!-- 前台价格区间：前端按「0-500 / 500-2000 / 5000-」传入 -->
            <if test="params.minPrice != null and params.minPrice != ''">
                AND price &gt;= #{params.minPrice}
            </if>
            <if test="params.maxPrice != null and params.maxPrice != ''">
                AND price &lt;= #{params.maxPrice}
            </if>
        </where>
        <choose>
            <when test="params.orderBy != null and 'priceAsc'.equals(params.orderBy.toString())">
                order by price asc, pet_id desc
            </when>
            <when test="params.orderBy != null and 'priceDesc'.equals(params.orderBy.toString())">
                order by price desc, pet_id desc
            </when>
            <when test="params.orderBy != null and 'categoryFirst'.equals(params.orderBy.toString())">
                order by case category_id when 1 then 0 when 2 then 1 when 3 then 2 else 9 end, pet_id desc
            </when>
            <otherwise>
                order by pet_id desc
            </otherwise>
        </choose>
    </select>

    <!-- 首页精选：在售优先、猫狗兔优先，一次只取 N 条，避免前端拉全表再截断 -->
    <select id="selectFeaturedPets" resultMap="PetInfoResult">
        <include refid="selectPetInfoVo"/>
        order by case status when '0' then 0 else 1 end,
                 case category_id when 1 then 0 when 2 then 1 when 3 then 2 else 9 end,
                 pet_id desc
        limit #{limit}
    </select>

    <!-- 概览统计：一条 SQL 出三个数，替代前端拉全表自己数 -->
    <select id="selectPetInfoCounts" resultType="java.util.HashMap">
        select count(*) as total,
               sum(case when status = '0' then 1 else 0 end) as onSale,
               count(distinct category_id) as categoryCount
        from pet_info
    </select>

    <!-- 品类快筛角标：只回分类与数量 -->
    <select id="selectPetCountByCategory" resultType="java.util.HashMap">
        select category_id as categoryId, count(*) as count
        from pet_info
        group by category_id
        order by category_id
    </select>

    <select id="selectPetInfoByPetId" parameterType="Long" resultMap="PetInfoResult">
        <include refid="selectPetInfoVo"/>
        where pet_id = #{petId}
    </select>

    <insert id="insertPetInfo" parameterType="PetInfo" useGeneratedKeys="true" keyProperty="petId">
        insert into pet_info(
            <if test="categoryId != null">category_id,</if>            <if test="petName != null and petName != ''">pet_name,</if>            <if test="breed != null and breed != ''">breed,</if>            <if test="age != null and age != ''">age,</if>            <if test="gender != null and gender != ''">gender,</if>            <if test="price != null">price,</if>            <if test="image != null and image != ''">image,</if>            <if test="status != null and status != ''">status,</if>            <if test="description != null and description != ''">description,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="categoryId != null">#{categoryId},</if>            <if test="petName != null and petName != ''">#{petName},</if>            <if test="breed != null and breed != ''">#{breed},</if>            <if test="age != null and age != ''">#{age},</if>            <if test="gender != null and gender != ''">#{gender},</if>            <if test="price != null">#{price},</if>            <if test="image != null and image != ''">#{image},</if>            <if test="status != null and status != ''">#{status},</if>            <if test="description != null and description != ''">#{description},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <!-- 修改 -->
    <update id="updatePetInfo" parameterType="PetInfo">
        update pet_info
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="petName != null and petName != ''">pet_name = #{petName},</if>
            <if test="breed != null and breed != ''">breed = #{breed},</if>
            <if test="age != null and age != ''">age = #{age},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="price != null">price = #{price},</if>
            <if test="image != null and image != ''">image = #{image},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="likeCount != null">like_count = #{likeCount},</if>
            update_time = sysdate()
        </set>
        where pet_id = #{petId}
    </update>

    <!-- 下单占位：只有「在售」才更新成功，天然防并发抢购 -->
    <update id="lockPet" parameterType="Long">
        update pet_info set status = '1', update_time = sysdate()
        where pet_id = #{petId} and status = '0'
    </update>

    <!-- 取消订单回滚 -->
    <update id="releasePet" parameterType="Long">
        update pet_info set status = '0', update_time = sysdate()
        where pet_id = #{petId} and status = '1'
    </update>

    <delete id="deletePetInfoByPetId" parameterType="Long">
        delete from pet_info where pet_id = #{petId}
    </delete>

    <delete id="deletePetInfoByPetIds" parameterType="Long">
        delete from pet_info where pet_id in
        <foreach item="petId" collection="array" open="(" separator="," close=")">
            #{petId}
        </foreach>
    </delete>

</mapper>
